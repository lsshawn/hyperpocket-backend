# Database
DATABASE_URL=postgresql://user:password@localhost:5432/hyperpocket

# Braintree Payment Gateway
BRAINTREE_MERCHANT_ID=your_merchant_id
BRAINTREE_PUBLIC_KEY=your_public_key
BRAINTREE_PRIVATE_KEY=your_private_key
BRAINTREE_ENVIRONMENT=sandbox # or production

# Multi-Currency Support (Optional)
# For multi-currency support, you may need separate merchant accounts per currency
# Contact Braintree support to enable additional currencies and get merchant account IDs
# Leave empty to use default merchant account
BRAINTREE_MERCHANT_ACCOUNT_USD=
BRAINTREE_MERCHANT_ACCOUNT_THB=
BRAINTREE_MERCHANT_ACCOUNT_MYR=
BRAINTREE_MERCHANT_ACCOUNT_SGD=
BRAINTREE_MERCHANT_ACCOUNT_EUR=
BRAINTREE_MERCHANT_ACCOUNT_GBP=
