# Database
DATABASE_URL=postgresql://user:password@localhost:5432/hyperpocket

# Braintree Payment Gateway
BRAINTREE_MERCHANT_ID=your_merchant_id
BRAINTREE_PUBLIC_KEY=your_public_key
BRAINTREE_PRIVATE_KEY=your_private_key
BRAINTREE_ENVIRONMENT=sandbox # or production

# Multi-Currency Support
# Note: Your Braintree merchant account must be configured for the currencies you want to support
# Supported currencies: USD, THB, MYR, SGD, EUR, GBP, etc.
# For multiple currencies, you may need separate merchant accounts per currency
# Contact Braintree support to enable additional currencies
